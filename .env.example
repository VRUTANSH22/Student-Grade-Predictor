# ──────────────────────────────────────────────────
#  Student Performance Predictor — Environment Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────────

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# ──────────────────────────────────────────────────
# Database
# Set USE_SQLITE=true to use SQLite (development/testing)
# Set USE_SQLITE=false to use MySQL (production)
# ──────────────────────────────────────────────────
USE_SQLITE=true

# MySQL (only used when USE_SQLITE=false)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_predictor
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# SQLite (only used when USE_SQLITE=true)
SQLITE_DB_PATH=student_predictor.db

# ──────────────────────────────────────────────────
# Paths
# ──────────────────────────────────────────────────
LOG_DIR=logs
MODEL_DIR=models

# ──────────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────────
# Port to run the dev server on
PORT=5000
# Host (0.0.0.0 to expose on network, 127.0.0.1 for local only)
HOST=0.0.0.0

# ML Model weights for ensemble (must sum to 1.0)
RF_WEIGHT=0.6
XGB_WEIGHT=0.4
